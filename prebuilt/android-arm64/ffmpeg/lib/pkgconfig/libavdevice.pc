prefix=/mnt/d/3rd-party-projects/ffmpeg-kit/prebuilt/android-arm64/ffmpeg
exec_prefix=${prefix}
libdir=/mnt/d/3rd-party-projects/ffmpeg-kit/prebuilt/android-arm64/ffmpeg/lib
includedir=/mnt/d/3rd-party-projects/ffmpeg-kit/prebuilt/android-arm64/ffmpeg/include

Name: libavdevice
Description: FFmpeg device handling library
Version: 62.3.103
Requires: 
Requires.private: libavfilter >= 11.14.103, libswscale >= 9.5.103, libavformat >= 62.12.103, libavcodec >= 62.28.103, libswresample >= 6.3.103, libavutil >= 60.26.103
Conflicts:
Libs: -L${libdir}  -lavdevice 
Libs.private: -lm -latomic -landroid -lcamera2ndk -lmediandk -pthread
Cflags: -I${includedir}
